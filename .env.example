# ==============================================================================
# Blocklog MCP Server Configuration (.env.example)
# ==============================================================================

# Backend API connection
# Set to the Blocklog control plane URL (e.g. http://127.0.0.1:8000 for local development)
BLOCKLOG_BACKEND_URL=http://127.0.0.1:8000

# Tenant API key used for authenticating with the Blocklog control plane.
# Required when using Transport::Stdio or Transport::Both.
BLOCKLOG_API_KEY=blk_live_your_tenant_api_key_here

# MCP Operating Mode:
#   - enforce: Full execution gateway enforcement. Actions are authorized, tokens consumed,
#              outcomes recorded, and cryptographic receipts issued.
#   - audit:   Dry-run mode. Check permissions and evaluate policies without executing
#              destructive side effects or consuming tokens.
BLOCKLOG_MCP_MODE=enforce

# MCP Transport Protocol:
#   - stdio:           Standard I/O pipes (default for Claude Desktop, Cursor, local agent CLI)
#   - streamable-http: HTTP server with Server-Sent Events (SSE) streaming support
#   - both:            Run both stdio and HTTP concurrently
BLOCKLOG_MCP_TRANSPORT=stdio

# HTTP Server Configuration (only used if transport is http or both)
BLOCKLOG_HTTP_BIND=127.0.0.1:8080
BLOCKLOG_HTTP_PATH=/mcp
BLOCKLOG_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
# BLOCKLOG_HTTP_ALLOWED_ORIGINS=https://your-dashboard.example.com

# Request & Payload Limits
BLOCKLOG_REQUEST_TIMEOUT_SECS=15
BLOCKLOG_MAX_ARGUMENT_BYTES=1048576
BLOCKLOG_MAX_RESPONSE_BYTES=8388608

# Logging format (compact | json)
BLOCKLOG_LOG_FORMAT=compact

# Security & Verification Trust Roots
# JSON map of signing keys: {"key_id": {"public_key": "hex_or_base64", "status": "active", "algorithm": "ed25519"}}
# BLOCKLOG_TRUST_ROOTS={"prod-root-1": {"public_key": "<hex>", "status": "active", "algorithm": "ed25519"}}

# Witness trust roots: {"witness_key_id": "<hex_public_key>"}
# BLOCKLOG_WITNESS_TRUST_ROOTS={"witness-1": "<hex>"}

# Counterparty trust roots: {"counterparty_key_id": "<hex_public_key>"}
# BLOCKLOG_COUNTERPARTY_TRUST_ROOTS={"stripe-signer": "<hex>"}

# Override default public key for single-key verifications
# BLOCKLOG_RECEIPT_PUBLIC_KEY=<hex_or_base64_ed25519_public_key>

# Insecure override for testing loopback without HTTPS (defaults to false)
BLOCKLOG_ALLOW_INSECURE_BACKEND=false
